<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Iska Wax Ubaro | Teacher Attendance Register</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #f1f5f9;
  color: #1e293b;
}

/* LOGIN */
#loginPage {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20px;
  background: linear-gradient(135deg, #0f172a, #1e40af);
}

.login-box {
  background: white;
  width: 100%;
  max-width: 400px;
  padding: 30px;
  border-radius: 18px;
  box-shadow: 0 15px 40px rgba(0,0,0,0.25);
  text-align: center;
}

.login-box h1 {
  color: #1e40af;
  margin-bottom: 8px;
}

.login-box p {
  color: #64748b;
  margin-bottom: 25px;
}

.login-box input {
  width: 100%;
  padding: 13px;
  margin-bottom: 15px;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  font-size: 16px;
}

.login-box button {
  width: 100%;
  padding: 13px;
  background: #1e40af;
  color: white;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

.login-box button:hover {
  background: #1d4ed8;
}

#errorMessage {
  color: #dc2626;
  margin-top: 12px;
  display: none;
}

/* MAIN APP */
#app {
  display: none;
}

header {
  background: #1e40af;
  color: white;
  padding: 25px 15px;
  text-align: center;
}

header h1 {
  font-size: 28px;
  margin-bottom: 5px;
}

header p {
  font-size: 15px;
  opacity: 0.9;
}

.container {
  width: 95%;
  max-width: 1100px;
  margin: 20px auto;
}

/* TOP BAR */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 15px;
  border-radius: 12px;
  margin-bottom: 20px;
  box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.teacher-info {
  font-weight: bold;
}

.logout-btn {
  background: #dc2626;
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
}

/* INFO CARDS */
.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-bottom: 20px;
}

.info-card {
  background: white;
  padding: 18px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.info-card h3 {
  color: #64748b;
  font-size: 14px;
  margin-bottom: 8px;
}

.info-card strong {
  font-size: 18px;
}

/* DATE */
.date-box {
  background: white;
  padding: 18px;
  border-radius: 12px;
  margin-bottom: 20px;
  box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.date-box label {
  font-weight: bold;
  display: block;
  margin-bottom: 8px;
}

.date-box input {
  width: 100%;
  max-width: 300px;
  padding: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 16px;
}

/* ATTENDANCE TABLE */
.attendance-box {
  background: white;
  border-radius: 12px;
  overflow-x: auto;
  box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 650px;
}

th {
  background: #1e40af;
  color: white;
  padding: 14px 8px;
}

td {
  padding: 12px 8px;
  text-align: center;
  border-bottom: 1px solid #e2e8f0;
}

td:first-child {
  text-align: left;
  font-weight: bold;
}

/* CHECK / X BUTTONS */
.attendance-option {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 42px;
  border: 2px solid #cbd5e1;
  border-radius: 9px;
  background: #f8fafc;
  cursor: pointer;
  font-size: 22px;
  font-weight: bold;
  transition: 0.2s;
}

.attendance-option input {
  display: none;
}

.present-option {
  color: #16a34a;
}

.absent-option {
  color: #dc2626;
}

.attendance-option:has(input:checked) {
  color: white;
}

.present-option:has(input:checked) {
  background: #16a34a;
  border-color: #16a34a;
}

.absent-option:has(input:checked) {
  background: #dc2626;
  border-color: #dc2626;
}

.attendance-option:hover {
  transform: scale(1.05);
}

/* SUMMARY */
.summary {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-top: 20px;
}

.summary-card {
  background: white;
  padding: 18px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.summary-card h3 {
  color: #64748b;
  font-size: 14px;
  margin-bottom: 8px;
}

.summary-card strong {
  font-size: 25px;
  color: #1e40af;
}

/* BUTTONS */
.buttons {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 20px;
}

.buttons button {
  border: none;
  padding: 12px 18px;
  border-radius: 8px;
  cursor: pointer;
  font-weight: bold;
  color: white;
}

.save-btn {
  background: #16a34a;
}

.clear-btn {
  background: #dc2626;
}

.print-btn {
  background: #475569;
}

/* MOBILE */
@media (max-width: 700px) {

  header h1 {
    font-size: 23px;
  }

  .info-grid {
    grid-template-columns: 1fr;
  }

  .summary {
    grid-template-columns: repeat(2, 1fr);
  }

  .top-bar {
    flex-direction: column;
    gap: 12px;
  }

  .logout-btn {
    width: 100%;
  }

  .attendance-option {
    width: 44px;
    height: 40px;
  }
}

/* PRINT */
@media print {

  #loginPage,
  .top-bar,
  .buttons {
    display: none !important;
  }

  #app {
    display: block !important;
  }

  body {
    background: white;
  }

  .container {
    width: 100%;
    margin: 0;
  }

  header {
    background: white;
    color: black;
    border-bottom: 2px solid black;
  }

  .info-card,
  .date-box,
  .attendance-box,
  .summary-card {
    box-shadow: none;
    border: 1px solid #ddd;
  }

  .attendance-option {
    border: none;
    background: white;
  }

  .attendance-option:has(input:checked) {
    background: white;
    color: black;
  }
}
</style>
</head>

<body>

<!-- LOGIN PAGE -->

<div id="loginPage">

  <div class="login-box">

    <h1>ISKA WAX UBARO</h1>

    <p>Teacher Attendance Login</p>

    <input
      type="text"
      id="username"
      placeholder="Teacher Username"
      autocomplete="username"
    >

    <input
      type="password"
      id="password"
      placeholder="Password"
      autocomplete="current-password"
    >

    <button onclick="login()">Login</button>

    <div id="errorMessage">
      Incorrect username or password.
    </div>

  </div>

</div>


<!-- MAIN APP -->

<div id="app">

<header>
  <h1>ISKA WAX UBARO</h1>
  <p>Student Attendance Register</p>
</header>

<div class="container">

  <!-- TEACHER -->

  <div class="top-bar">

    <div class="teacher-info">
      👨‍🏫 Teacher: Sh. Pilipili
    </div>

    <button class="logout-btn" onclick="logout()">
      Logout
    </button>

  </div>


  <!-- SCHOOL INFORMATION -->

  <div class="info-grid">

    <div class="info-card">
      <h3>Institution</h3>
      <strong>Iska Wax Ubaro</strong>
    </div>

    <div class="info-card">
      <h3>Classroom</h3>
      <strong>Class 1C</strong>
    </div>

    <div class="info-card">
      <h3>Teacher</h3>
      <strong>Sh. Pilipili</strong>
    </div>

  </div>


  <!-- DATE -->

  <div class="date-box">

    <label for="attendanceDate">
      Attendance Date
    </label>

    <input
      type="date"
      id="attendanceDate"
      onchange="loadAttendance()"
    >

  </div>


  <!-- ATTENDANCE -->

  <div class="attendance-box">

    <table>

      <thead>

        <tr>
          <th>Student</th>
          <th colspan="2">Morning</th>
          <th colspan="2">Afternoon</th>
        </tr>

        <tr>
          <th></th>
          <th>✓</th>
          <th>✕</th>
          <th>✓</th>
          <th>✕</th>
        </tr>

      </thead>

      <tbody id="attendanceBody"></tbody>

    </table>

  </div>


  <!-- SUMMARY -->

  <div class="summary">

    <div class="summary-card">
      <h3>Total Students</h3>
      <strong id="totalStudents">5</strong>
    </div>

    <div class="summary-card">
      <h3>Morning Present</h3>
      <strong id="morningPresent">0</strong>
    </div>

    <div class="summary-card">
      <h3>Afternoon Present</h3>
      <strong id="afternoonPresent">0</strong>
    </div>

    <div class="summary-card">
      <h3>Attendance %</h3>
      <strong id="attendancePercentage">0%</strong>
    </div>

  </div>


  <!-- BUTTONS -->

  <div class="buttons">

    <button
      class="save-btn"
      onclick="saveAttendance()">
      💾 Save Attendance
    </button>

    <button
      class="clear-btn"
      onclick="clearAttendance()">
      🗑 Clear
    </button>

    <button
      class="print-btn"
      onclick="window.print()">
      🖨 Print
    </button>

  </div>

</div>

</div>


<script>

/* LOGIN DETAILS */

const correctUsername = "pilipili";
const correctPassword = "1234";


/* STUDENTS */

const students = [
  "Student 1",
  "Student 2",
  "Student 3",
  "Student 4",
  "Student 5"
];


/* LOGIN */

function login() {

  const username =
    document.getElementById("username").value.trim();

  const password =
    document.getElementById("password").value;

  const error =
    document.getElementById("errorMessage");

  if (
    username === correctUsername &&
    password === correctPassword
  ) {

    localStorage.setItem(
      "teacherLoggedIn",
      "true"
    );

    error.style.display = "none";

    document.getElementById("loginPage").style.display =
      "none";

    document.getElementById("app").style.display =
      "block";

    initializeApp();

  } else {

    error.style.display = "block";

  }
}


/* LOGOUT */

function logout() {

  localStorage.removeItem("teacherLoggedIn");

  document.getElementById("app").style.display =
    "none";

  document.getElementById("loginPage").style.display =
    "flex";

  document.getElementById("username").value = "";
  document.getElementById("password").value = "";

}


/* ENTER KEY */

document.getElementById("password").addEventListener(
  "keydown",
  function(event) {

    if (event.key === "Enter") {
      login();
    }

  }
);


/* INITIALIZE */

function initializeApp() {

  const dateInput =
    document.getElementById("attendanceDate");

  if (!dateInput.value) {

    const today =
      new Date().toISOString().split("T")[0];

    dateInput.value = today;

  }

  createStudentRows();

  loadAttendance();

}


/* CREATE STUDENTS */

function createStudentRows() {

  const body =
    document.getElementById("attendanceBody");

  body.innerHTML = "";

  students.forEach((student, index) => {

    const row =
      document.createElement("tr");

    row.innerHTML = `

      <td>${student}</td>

      <!-- MORNING PRESENT -->

      <td>

        <label class="attendance-option present-option">

          <input
            type="radio"
            name="morning-${index}"
            value="present"
            onchange="updateSummary()"
          >

          ✓

        </label>

      </td>

      <!-- MORNING ABSENT -->

      <td>

        <label class="attendance-option absent-option">

          <input
            type="radio"
            name="morning-${index}"
            value="absent"
            onchange="updateSummary()"
          >

          ✕

        </label>

      </td>

      <!-- AFTERNOON PRESENT -->

      <td>

        <label class="attendance-option present-option">

          <input
            type="radio"
            name="afternoon-${index}"
            value="present"
            onchange="updateSummary()"
          >

          ✓

        </label>

      </td>

      <!-- AFTERNOON ABSENT -->

      <td>

        <label class="attendance-option absent-option">

          <input
            type="radio"
            name="afternoon-${index}"
            value="absent"
            onchange="updateSummary()"
          >

          ✕

        </label>

      </td>

    `;

    body.appendChild(row);

  });

}


/* SAVE */

function saveAttendance() {

  const date =
    document.getElementById("attendanceDate").value;

  if (!date) {

    alert("Please select a date.");

    return;

  }

  const attendance = {};

  students.forEach((student, index) => {

    const morning =
      document.querySelector(
        `input[name="morning-${index}"]:checked`
      );

    const afternoon =
      document.querySelector(
        `input[name="afternoon-${index}"]:checked`
      );

    attendance[index] = {

      morning:
        morning ? morning.value : "",

      afternoon:
        afternoon ? afternoon.value : ""

    };

  });

  localStorage.setItem(
    "attendance-" + date,
    JSON.stringify(attendance)
  );

  alert(
    "Attendance saved successfully for " + date
  );

  updateSummary();

}


/* LOAD */

function loadAttendance() {

  const date =
    document.getElementById("attendanceDate").value;

  if (!date) return;

  const saved =
    localStorage.getItem(
      "attendance-" + date
    );


  students.forEach((student, index) => {

    document
      .querySelectorAll(
        `input[name="morning-${index}"]`
      )
      .forEach(input => {
        input.checked = false;
      });

    document
      .querySelectorAll(
        `input[name="afternoon-${index}"]`
      )
      .forEach(input => {
        input.checked = false;
      });

  });


  if (saved) {

    const attendance =
      JSON.parse(saved);

    students.forEach((student, index) => {

      if (!attendance[index]) return;


      if (attendance[index].morning) {

        const radio =
          document.querySelector(
            `input[name="morning-${index}"][value="${attendance[index].morning}"]`
          );

        if (radio) {
          radio.checked = true;
        }

      }


      if (attendance[index].afternoon) {

        const radio =
          document.querySelector(
            `input[name="afternoon-${index}"][value="${attendance[index].afternoon}"]`
          );

        if (radio) {
          radio.checked = true;
        }

      }

    });

  }

  updateSummary();

}


/* CLEAR */

function clearAttendance() {

  const date =
    document.getElementById("attendanceDate").value;

  if (!date) return;

  const confirmClear =
    confirm(
      "Are you sure you want to clear attendance for this date?"
    );

  if (!confirmClear) return;

  localStorage.removeItem(
    "attendance-" + date
  );


  students.forEach((student, index) => {

    document
      .querySelectorAll(
        `input[name="morning-${index}"]`
      )
      .forEach(input => {
        input.checked = false;
      });

    document
      .querySelectorAll(
        `input[name="afternoon-${index}"]`
      )
      .forEach(input => {
        input.checked = false;
      });

  });

  updateSummary();

}


/* SUMMARY */

function updateSummary() {

  let morningPresent = 0;
  let afternoonPresent = 0;


  students.forEach((student, index) => {

    const morning =
      document.querySelector(
        `input[name="morning-${index}"]:checked`
      );

    const afternoon =
      document.querySelector(
        `input[name="afternoon-${index}"]:checked`
      );


    if (
      morning &&
      morning.value === "present"
    ) {

      morningPresent++;

    }


    if (
      afternoon &&
      afternoon.value === "present"
    ) {

      afternoonPresent++;

    }

  });


  const total =
    students.length;

  const totalSessions =
    total * 2;

  const totalPresent =
    morningPresent + afternoonPresent;

  const percentage =
    totalSessions > 0
      ? Math.round(
          (totalPresent / totalSessions) * 100
        )
      : 0;


  document.getElementById(
    "totalStudents"
  ).textContent = total;

  document.getElementById(
    "morningPresent"
  ).textContent = morningPresent;

  document.getElementById(
    "afternoonPresent"
  ).textContent = afternoonPresent;

  document.getElementById(
    "attendancePercentage"
  ).textContent =
    percentage + "%";

}


/* CHECK LOGIN */

window.onload = function() {

  const loggedIn =
    localStorage.getItem(
      "teacherLoggedIn"
    );


  if (loggedIn === "true") {

    document.getElementById(
      "loginPage"
    ).style.display = "none";

    document.getElementById(
      "app"
    ).style.display = "block";

    initializeApp();

  } else {

    document.getElementById(
      "loginPage"
    ).style.display = "flex";

    document.getElementById(
      "app"
    ).style.display = "none";

  }

};

</script>

</body>
</html>